# Configuração do openssl ts -reply para a TSA de TESTE. O diretório vem da variável TSA_DIR.
TSA_DIR = .
[ tsa ]
default_tsa = tsa_config1
[ tsa_config1 ]
dir = $ENV::TSA_DIR
serial = $dir/serial.txt
crypto_device = builtin
signer_cert = $dir/tsa.crt
certs = $dir/tsa.crt
signer_key = $dir/tsa.key
signer_digest = sha256
default_policy = 1.3.6.1.4.1.99999.1
digests = sha256
accuracy = secs:1
clock_precision_digits = 3
ordering = yes
tsa_name = yes
ess_cert_id_chain = no
ess_cert_id_alg = sha256
